    {
      "id": "Gjvn8GdG5rKshm2qYeTZN",
      "type": "text",
      "x": -60.7797619047617,
      "y": 891.9186507936508,
      "width": 602.099609375,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "QBxjgcufwYictxskSLb1V",
      "index": "am",
      "roundness": null,
      "seed": 711575450,
      "version": 281,
      "versionNonce": 770273818,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "xlhB98MmffVSjX2cGaygE",
          "type": "arrow"
        },
        {
          "id": "S3T0IN7hJUUp3uF0uxhSO",
          "type": "arrow"
        }
      ],
      "updated": 1783811080748,
      "link": null,
      "locked": false,
      "text": "  ① Triage Agent (Gemini Flash)                                    \n     └─ Classifies PR: skip / lightweight / full review            \n                                                                    \n  ② Parallel Execution (Gemini Flash × 3)                          \n     ├─ Security Agent     ─── OWASP patterns, injection, secrets \n     ├─ Style Agent        ─── linting rules, naming, formatting  \n     └─ Test Coverage Agent ── test-to-code ratio, missing cases   \n                                                                    \n  ③ Codebase Context Agent (Gemini Flash + Pinecone RAG)           \n     └─ Enriches findings with repo/org/developer memory           \n                                                                    \n  ④ Aggregator Agent (Gemini Pro)                                  \n     └─ Synthesizes all findings → structured review output        \n                                                                    \n  [Extensibility hooks reserved for:]                               \n  ⑤ Duplication Detection Agent (future)                           \n  ⑥ Architecture Consistency Agent (future)   ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  ① Triage Agent (Gemini Flash)                                       \n     └─ Classifies PR: skip / lightweight / full review               \n                                                                       \n  ② Parallel Execution (Gemini Flash × 3)                             \n     ├─ Security Agent     ─── OWASP patterns, injection, secrets     \n     ├─ Style Agent        ─── linting rules, naming, formatting      \n     └─ Test Coverage Agent ── test-to-code ratio, missing cases      \n                                                                       \n  ③ Codebase Context Agent (Gemini Flash + Pinecone RAG)              \n     └─ Enriches findings with repo/org/developer memory              \n                                                                       \n  ④ Aggregator Agent (Gemini Pro)                                     \n     └─ Synthesizes all findings → structured review output           \n                                                                       \n  [Extensibility hooks reserved for:]                                 \n  ⑤ Duplication Detection Agent (future)                              \n  ⑥ Architecture Consistency Agent (future)   ",
      "autoResize": false,
      "lineHeight": 1.25
    },
