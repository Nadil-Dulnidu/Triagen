# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_CORS_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pullsense

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Clerk Authentication ─────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
CLERK_JWKS_URL=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev

# ── GitHub App ───────────────────────────────────────────────────────
GITHUB_APP_ID=0
GITHUB_APP_PRIVATE_KEY=REPLACE_ME
GITHUB_WEBHOOK_SECRET=REPLACE_ME
GITHUB_APP_CLIENT_ID=REPLACE_ME
GITHUB_APP_CLIENT_SECRET=REPLACE_ME

# ── GCP Vertex AI & Agent Platform (ADK) ────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004

# ── Pinecone ─────────────────────────────────────────────────────────
PINECONE_API_KEY=REPLACE_ME
PINECONE_INDEX_NAME=pullsense

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_REVIEWS_PER_HOUR=100
